# =============================================================================
# AR Commerce Platform — Environment Variables
# Copy this to .env and fill in the values
# =============================================================================

# -- Supabase (required) ------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # service_role key (server-only, bypasses RLS)
SUPABASE_PUBLISHABLE_KEY=eyJ...          # anon/publishable key (client + server)

# -- Vite public env (client-side, prefixed with VITE_) -----------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

# -- App URL (required for webhooks & OG images) ------------------------------
APP_URL=http://localhost:3000              # Dev: http://localhost:3000; Prod: https://your-domain.com
WEBHOOK_BASE_URL=http://localhost:3000     # Where AI providers send callbacks

# -- Vendor Webhook Secrets (required for marketplace webhook sync) ------------
SHOPIFY_CLIENT_SECRET=                    # Shopify webhook HMAC secret (from Shopify Admin → Notifications)
SHOPIFY_WEBHOOK_SECRET=                   # Same value as SHOPIFY_CLIENT_SECRET (used by /api/webhooks/shopify; route 503s when unset)
SHOPIFY_API_KEY=                          # Shopify Admin API key (for REST queries)
AMAZON_CLIENT_SECRET=                     # Amazon SP-API notification signing secret
DARAZ_CLIENT_SECRET=                      # Daraz Open Platform webhook signature key

# -- Security (required for token encryption) ----------------------------------
SESSION_SECRET=                            # ≥32 chars; used for AES-GCM encryption of marketplace tokens. Falls back to SUPABASE_SERVICE_ROLE_KEY if unset (insecure)
ENABLE_DEVELOPER_TOOLS=false               # Set true (dev only) to enable devQuickSetup / simulate-webhook / reset-demo utilities

# -- AI Providers (optional — enables 3D generation pipeline) -----------------
# Provider used for new generation jobs: simulated | meshy | tripo.
#   simulated (default): runs the pipeline end-to-end with no API key, but
#     produces no model artifact — use for demos until Meshy is attached.
#   meshy / tripo: real generation. Set the matching API key below and a
#     publicly reachable WEBHOOK_BASE_URL so completion callbacks resolve.
AI_PROVIDER=simulated
SIMULATED_GENERATION_MS=8000              # Simulated provider turnaround (demo only)
MESHY_API_KEY=                            # https://platform.meshy.ai
MESHY_API_URL=https://api.meshy.ai        # Default: https://api.meshy.ai
TRIPO_API_KEY=                            # https://platform.tripo3d.ai
TRIPO_API_URL=https://api.tripo3d.ai/v2/openapi  # Default

# -- Resend (required for transactional emails) --------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx   # https://resend.com/api-keys
# ⚠️ Before enabling branded sending, verify your domain at https://resend.com/domains
EMAIL_FROM="Rapidify <onboarding@resend.dev>"

# -- Node (optional) ----------------------------------------------------------
NODE_ENV=development
